# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# For SQLite (default)
DB_TYPE=sqlite
DB_DATABASE=easyprompt.db

# For MySQL
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=easyprompt
# DB_USERNAME=root
# DB_PASSWORD=password

# For PostgreSQL
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=easyprompt
# DB_USERNAME=postgres
# DB_PASSWORD=password

# JWT Configuration (if authentication is added later)
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=24h

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads